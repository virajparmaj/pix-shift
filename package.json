{
  "name": "pix-shift",
  "version": "1.1.0",
  "description": "Chrome extension that converts HEIC downloads from Google Photos to PNG or JPEG",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "clean": "rm -rf dist",
    "dev": "tsx scripts/build.ts --watch",
    "release:check": "npm run build && tsx scripts/release-check.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "heic-to": "^1.4.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^24.5.2",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  }
}
