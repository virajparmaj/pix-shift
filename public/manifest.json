{
  "manifest_version": 3,
  "name": "PixShift",
  "version": "1.1.0",
  "description": "Auto-converts HEIC downloads from Google Photos to PNG or JPEG",
  "permissions": [
    "downloads",
    "offscreen",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/action-icon-16.png",
      "48": "icons/action-icon-48.png",
      "128": "icons/action-icon-128.png"
    }
  },
  "icons": {
    "16": "icons/details-icon-16.png",
    "48": "icons/details-icon-48.png",
    "128": "icons/details-icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
